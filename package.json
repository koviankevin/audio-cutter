{
  "name": "audio-cutter",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "音剪 — 在瀏覽器內完成音檔剪輯",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/core.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:streaming": "node tests/streaming.mjs",
    "test:export-memory": "node tests/export-memory.mjs",
    "test:export-lifecycle": "node tests/export-lifecycle.mjs",
    "test:mp3-speed": "node tests/mp3-speed.mjs",
    "test:mp3-export": "node tests/mp3-export.mjs",
    "test:export-preview": "node tests/export-preview.mjs && node tests/projects.mjs && node tests/product.mjs",
    "test:font-size": "node tests/font-size.mjs",
    "test:projects": "node tests/projects.mjs",
    "test:product": "node tests/product.mjs",
    "test:product-long": "node tests/product-long.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "license": "MIT"
}
